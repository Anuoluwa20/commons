# Public URL of the site (used in emails, calendar files and share links)
COMMONS_SITE_URL=https://commons.example.com
# Optional: send ticket emails through Resend (https://resend.com). Leave empty to skip email.
RESEND_API_KEY=
COMMONS_FROM_EMAIL=Commons <tickets@your-domain.com>
# Where the JSON store keeps RSVPs, list signups and messages (default: ./.data)
COMMONS_DATA_DIR=
